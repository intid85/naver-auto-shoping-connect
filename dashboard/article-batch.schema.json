{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["articles"],
  "properties": {
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["folder", "content"],
        "properties": {
          "folder": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    }
  }
}
